# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Whisper Model Configuration
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3, large-v3-turbo
WHISPER_MODEL_SIZE=large-v3-turbo

# Device: cuda, cpu, or auto
WHISPER_DEVICE=auto

# Compute Type: float16, int8, int8_float16, float32, or auto
WHISPER_COMPUTE_TYPE=auto

# CPU Threads (optional, for CTranslate2 CPU execution)
WHISPER_CPU_THREADS=4

# Default ASR Pipeline Settings
DEFAULT_BEAM_SIZE=5
DEFAULT_VAD_FILTER=true
DEFAULT_MIN_SILENCE_DURATION_MS=500
DEFAULT_SPEECH_PAD_MS=200

# Limits
MAX_UPLOAD_SIZE_MB=100
